{
  "name": "@perennia/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "start": "node --import tsx src/index.ts",
    "start:worker": "node --import tsx src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.mjs",
    "test:sync-convergence": "node --import tsx --test --test-concurrency=1 test/sync-convergence.test.mjs",
    "test:golden-vectors": "node --import tsx --test test/analytics.golden.test.mjs test/metric-reading-normalization.golden.test.mjs test/agent-validation.golden.test.mjs test/nutrition-analytics.golden.test.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.1",
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.69.0",
    "better-auth": "1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "nodemailer": "9.0.5",
    "pg-boss": "12.27.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.11"
  }
}
