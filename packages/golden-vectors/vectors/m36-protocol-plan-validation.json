    {
      "name": "as-needed-rule-with-an-amount-rejects",
      "validator": "schedule_rule",
      "note": "D7 amount_absent: an as_needed rule plans nothing, so its stored amount fields stay null; one carrying an amount, unit and route rejects.",
      "input": {"rule": {"v": 1, "kind": "as_needed"}, "amountValue": 20, "amountEntered": "20", "unit": "milligram", "route": "oral"},
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["amount_absent"]}
    },
    {
      "name": "as-needed-rule-with-a-blank-amount-entered-rejects",
      "validator": "schedule_rule",
      "note": "D7 amount_absent: absent means null or missing. A blank amountEntered (spaces) is a value, so an as_needed rule that carries it rejects, though amount_required would read the same blank as missing.",
      "input": {"rule": {"v": 1, "kind": "as_needed"}, "amountValue": null, "amountEntered": "  ", "unit": null, "route": null},
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["amount_absent"]}
    },
