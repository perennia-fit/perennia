{
  "name": "m36-protocol-plan-validation",
  "domain": "protocol-plan-validation",
  "schemaVersion": 1,
  "schema": "m36-protocol-plan-validation.schema.json",
  "limits": {
    "maxTimesPerDay": 12,
    "maxUntimedCount": 12,
    "minEveryNDays": 2,
    "maxEveryNDays": 365,
    "maxCycleLengthDays": 3650,
    "warnTimesPerDay": 6,
    "maxPauses": 100
  },
  "cases": [
    {
      "name": "timed-daily-rule-is-valid",
      "validator": "schedule_rule",
      "note": "D7: an ordinary timed rule with its amount, unit and route.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "daily"}, "times": ["09:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "untimed-weekdays-rule-is-valid",
      "validator": "schedule_rule",
      "note": "D7: an untimed count on chosen weekdays.",
      "input": {
        "rule": {"v": 1, "kind": "untimed", "days": {"kind": "weekdays", "weekdays": [1, 3, 5]}, "count": 2},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "every-n-days-rule-is-valid",
      "validator": "schedule_rule",
      "note": "D7: every N days with a valid anchor.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 3, "anchor": "2026-09-01", "anchor_is_default": true},
          "times": ["08:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "as-needed-rule-needs-no-amount",
      "validator": "schedule_rule",
      "note": "D7 amount_required: only timed and untimed rules need an amount.",
      "input": {"rule": {"v": 1, "kind": "as_needed"}, "amountValue": null, "amountEntered": null, "unit": null, "route": null},
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "unscheduled-rule-needs-no-amount",
      "validator": "schedule_rule",
      "note": "D7 amount_required: only timed and untimed rules need an amount.",
      "input": {"rule": {"v": 1, "kind": "unscheduled"}, "amountValue": null, "amountEntered": null, "unit": null, "route": null},
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "times-at-the-day-boundaries-are-valid",
      "validator": "schedule_rule",
      "note": "D7 times_format: 00:00 and 23:59 are the first and last valid times.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "daily"}, "times": ["00:00", "23:59"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "time-without-two-digit-hour-rejects",
      "validator": "schedule_rule",
      "note": "D7 times_format: each time is HH:MM.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "daily"}, "times": ["9:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["times_format"]}
    },
    {
      "name": "time-at-24-00-rejects",
      "validator": "schedule_rule",
      "note": "D7 times_format: hours run 00-23.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "daily"}, "times": ["24:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["times_format"]}
    },
    {
      "name": "time-at-minute-60-rejects",
      "validator": "schedule_rule",
      "note": "D7 times_format: minutes run 00-59.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "daily"}, "times": ["23:60"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["times_format"]}
    },
    {
      "name": "no-times-rejects",
      "validator": "schedule_rule",
      "note": "D7 times_count: a timed rule has 1 to 12 times.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "daily"}, "times": []},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["times_count"]}
    },
    {
      "name": "six-times-is-valid-without-a-warning",
      "validator": "schedule_rule",
      "note": "D7 times_many: the warning starts above 6 times a day.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "daily"}, "times": ["00:00", "01:00", "02:00", "03:00", "04:00", "05:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "seven-times-soft-warns",
      "validator": "schedule_rule",
      "note": "D7 times_many: more than 6 times a day warns.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "daily"},
          "times": ["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": ["times_many"], "errorRules": []}
    },
    {
      "name": "twelve-times-is-valid-but-warns",
      "validator": "schedule_rule",
      "note": "D7 times_count: 12 is the maximum; times_many still warns.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "daily"},
          "times": ["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": ["times_many"], "errorRules": []}
    },
    {
      "name": "thirteen-times-rejects-and-warns",
      "validator": "schedule_rule",
      "note": "D7 times_count: more than 12 times rejects; times_many is an independent check, judged alongside the errors rather than only when there are none, so it still warns.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "daily"},
          "times": ["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": ["times_many"], "errorRules": ["times_count"]}
    },
    {
      "name": "duplicate-times-reject",
      "validator": "schedule_rule",
      "note": "D7 times_distinct: no duplicate times.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "daily"}, "times": ["09:00", "09:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["times_distinct"]}
    },
    {
      "name": "untimed-count-of-one-is-valid",
      "validator": "schedule_rule",
      "note": "D7 untimed_count: 1 is the minimum.",
      "input": {
        "rule": {"v": 1, "kind": "untimed", "days": {"kind": "daily"}, "count": 1},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "untimed-count-of-twelve-is-valid",
      "validator": "schedule_rule",
      "note": "D7 untimed_count: 12 is the maximum.",
      "input": {
        "rule": {"v": 1, "kind": "untimed", "days": {"kind": "daily"}, "count": 12},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "untimed-count-of-zero-rejects",
      "validator": "schedule_rule",
      "note": "D7 untimed_count: 1 to 12.",
      "input": {
        "rule": {"v": 1, "kind": "untimed", "days": {"kind": "daily"}, "count": 0},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["untimed_count"]}
    },
    {
      "name": "untimed-count-of-thirteen-rejects",
      "validator": "schedule_rule",
      "note": "D7 untimed_count: 1 to 12.",
      "input": {
        "rule": {"v": 1, "kind": "untimed", "days": {"kind": "daily"}, "count": 13},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["untimed_count"]}
    },
    {
      "name": "untimed-count-of-two-and-a-half-rejects",
      "validator": "schedule_rule",
      "note": "D7 untimed_count: a fractional count is not a count.",
      "input": {
        "rule": {"v": 1, "kind": "untimed", "days": {"kind": "daily"}, "count": 2.5},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["untimed_count"]}
    },
    {
      "name": "untimed-count-written-as-a-float-is-valid",
      "validator": "schedule_rule",
      "note": "D7 untimed_count: JSON cannot tell 2.0 from 2, so neither language does.",
      "input": {
        "rule": {"v": 1, "kind": "untimed", "days": {"kind": "daily"}, "count": 2.0},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "all-seven-weekdays-are-valid",
      "validator": "schedule_rule",
      "note": "D7 weekdays_valid: ISO weekdays 1-7.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "weekdays", "weekdays": [1, 2, 3, 4, 5, 6, 7]}, "times": ["09:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "empty-weekdays-reject",
      "validator": "schedule_rule",
      "note": "D7 weekdays_valid: non-empty.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "weekdays", "weekdays": []}, "times": ["09:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["weekdays_valid"]}
    },
    {
      "name": "weekday-zero-rejects",
      "validator": "schedule_rule",
      "note": "D7 weekdays_valid: each is 1-7.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "weekdays", "weekdays": [0]}, "times": ["09:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["weekdays_valid"]}
    },
    {
      "name": "weekday-eight-rejects",
      "validator": "schedule_rule",
      "note": "D7 weekdays_valid: each is 1-7.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "weekdays", "weekdays": [8]}, "times": ["09:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["weekdays_valid"]}
    },
    {
      "name": "fractional-weekday-rejects",
      "validator": "schedule_rule",
      "note": "D7 weekdays_valid: each is a whole ISO weekday.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "weekdays", "weekdays": [1.5]}, "times": ["09:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["weekdays_valid"]}
    },
    {
      "name": "duplicate-weekdays-reject",
      "validator": "schedule_rule",
      "note": "D7 weekdays_valid: no duplicates.",
      "input": {
        "rule": {"v": 1, "kind": "timed", "days": {"kind": "weekdays", "weekdays": [1, 1]}, "times": ["09:00"]},
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["weekdays_valid"]}
    },
    {
      "name": "every-2-days-is-valid",
      "validator": "schedule_rule",
      "note": "D7 every_n_range: 2 is the minimum.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 2, "anchor": "2026-09-01", "anchor_is_default": true},
          "times": ["09:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "every-365-days-is-valid",
      "validator": "schedule_rule",
      "note": "D7 every_n_range: 365 is the maximum.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 365, "anchor": "2026-09-01", "anchor_is_default": true},
          "times": ["09:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": true, "warningRules": [], "errorRules": []}
    },
    {
      "name": "every-1-day-rejects",
      "validator": "schedule_rule",
      "note": "D7 every_n_range: 2 to 365 (every day is the daily kind).",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 1, "anchor": "2026-09-01", "anchor_is_default": true},
          "times": ["09:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["every_n_range"]}
    },
    {
      "name": "every-366-days-rejects",
      "validator": "schedule_rule",
      "note": "D7 every_n_range: 2 to 365.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 366, "anchor": "2026-09-01", "anchor_is_default": true},
          "times": ["09:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
      "expected": {"accepted": false, "warningRules": [], "errorRules": ["every_n_range"]}
    },
    {
      "name": "every-n-days-anchor-on-an-impossible-date-rejects",
      "validator": "schedule_rule",
      "note": "D7 anchor_date: the anchor is a valid date.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 3, "anchor": "2026-02-30", "anchor_is_default": true},
          "times": ["09:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
