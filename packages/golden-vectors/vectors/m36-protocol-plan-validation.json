    },
    {
      "name": "every-n-days-anchor-in-year-0-is-valid",
      "validator": "schedule_rule",
      "note": "D7 anchor_date: 0000-01-01 is the earliest YYYY-MM-DD date.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 2, "anchor": "0000-01-01", "anchor_is_default": false},
