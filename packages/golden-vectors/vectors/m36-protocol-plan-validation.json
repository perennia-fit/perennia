    },
    {
      "name": "every-1-day-rejects",
      "validator": "schedule_rule",
      "note": "D7 every_n_range: 2 to 365 (every day is the daily kind).",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 1, "anchor": "2026-09-01", "anchor_is_default": true},
