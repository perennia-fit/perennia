    {
      "name": "cycle-with-a-pause-is-valid",
      "validator": "protocol_period",
      "note": "D4: the CUJ 3 and CUJ 5 period.",
      "input": {
        "startLocalDate": "2026-09-01",
        "endLocalDate": null,
        "period": {
