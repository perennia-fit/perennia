    },
    {
      "name": "every-n-days-anchor-in-year-50-is-valid",
      "validator": "schedule_rule",
      "note": "D7 anchor_date: a four-digit year is taken as written, never as 1950.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 2, "anchor": "0050-01-02", "anchor_is_default": false},
          "times": ["09:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
