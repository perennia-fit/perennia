    },
    {
      "name": "every-n-days-anchor-in-another-format-rejects",
      "validator": "schedule_rule",
      "note": "D7 anchor_date: the anchor is a valid YYYY-MM-DD date.",
      "input": {
        "rule": {
          "v": 1,
          "kind": "timed",
          "days": {"kind": "every_n_days", "n": 3, "anchor": "2026/09/01", "anchor_is_default": true},
          "times": ["09:00"]
        },
        "amountValue": 20,
        "amountEntered": "20",
        "unit": "milligram",
        "route": "subcutaneous"
      },
