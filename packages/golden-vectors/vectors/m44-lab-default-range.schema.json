{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m44-lab-default-range.schema.json",
  "title": "M44 Lab Default Range golden vector",
  "description": "Dart-only cases for Default Range selection, Printed Range parsing and range position (docs/designs/lab-results.md, Default Ranges); no server reader computes them. Each case names its function. defaultRangeFor: a non-blank printedRange means none; keep entries whose sex is any or equals sex (a sex-specific entry never shows when sex is null); keep entries whose inclusive age band contains age (a banded entry never shows when age is null; a null end is unbounded); exactly one entry left is the result, otherwise null. Its entries are given inline, not from the real catalogue, so two matching entries can be expressed. parsePrintedRange: trim, strip one pair of surrounding parentheses or square brackets, trim again; case-insensitive; runs of whitespace are one space; spaces around a symbol are optional, a word form needs them; a number is -?digits(.digits)?; the whole text must match one form of the grammar table, or the result is null; a-b with a > b is null. A missing side is null with its inclusive flag true. rangePosition: a missing side is unbounded and each side's inclusivity is honoured; a Limit Result is never equal to its bound. resultPosition: a parsing printedRange is used (source printed) unless kind is riskTarget, which yields null; otherwise defaultRange with inclusive bounds (source general); with neither, null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "domain", "schemaVersion", "schema", "cases"],
  "properties": {
    "name": {"const": "m44-lab-default-range"},
    "domain": {"const": "lab-default-range"},
    "schemaVersion": {"const": 1},
    "schema": {"const": "m44-lab-default-range.schema.json"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "nullableInteger": {"type": ["integer", "null"]},
    "defaultRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sex", "ageMin", "ageMax", "low", "high", "source"],
      "properties": {
        "sex": {"enum": ["female", "male", "any"]},
        "ageMin": {"$ref": "#/$defs/nullableInteger"},
        "ageMax": {"$ref": "#/$defs/nullableInteger"},
        "low": {"$ref": "#/$defs/nullableNumber"},
        "high": {"$ref": "#/$defs/nullableNumber"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url", "version"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "parsedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "lowInclusive", "high", "highInclusive"],
      "properties": {
        "low": {"$ref": "#/$defs/nullableNumber"},
        "lowInclusive": {"type": "boolean"},
        "high": {"$ref": "#/$defs/nullableNumber"},
        "highInclusive": {"type": "boolean"}
      }
    },
    "labValue": {
      "description": "A number, or the limit of a Limit Result.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number"],
          "properties": {"number": {"type": "number"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit"],
          "properties": {
            "limit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["comparator", "bound"],
              "properties": {
                "comparator": {"enum": ["<", "<=", ">", ">="]},
                "bound": {"type": "number"}
              }
            }
          }
        }
      ]
    },
    "position": {"enum": ["below", "within", "above", "unknown"]},
    "case": {
      "type": "object",
      "required": ["name", "function", "input", "expected"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "note": {"type": "string", "description": "Why the case exists and which rule it pins. Runners ignore it."},
        "function": {"enum": ["defaultRangeFor", "parsePrintedRange", "rangePosition", "resultPosition"]}
      },
      "oneOf": [
        {
          "properties": {
            "name": true,
            "note": true,
            "function": {"const": "defaultRangeFor"},
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["defaultRanges", "printedRange", "sex", "age"],
              "properties": {
                "defaultRanges": {"type": "array", "items": {"$ref": "#/$defs/defaultRange"}},
                "printedRange": {"type": ["string", "null"]},
                "sex": {"enum": ["female", "male", null]},
                "age": {"$ref": "#/$defs/nullableInteger"}
              }
            },
            "expected": {
              "description": "The chosen entry, or null for none.",
              "oneOf": [{"$ref": "#/$defs/defaultRange"}, {"type": "null"}]
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "name": true,
            "note": true,
            "function": {"const": "parsePrintedRange"},
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {"text": {"type": "string"}}
            },
            "expected": {
              "oneOf": [{"$ref": "#/$defs/parsedRange"}, {"type": "null"}]
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "name": true,
            "note": true,
            "function": {"const": "rangePosition"},
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "range"],
              "properties": {
                "value": {"$ref": "#/$defs/labValue"},
                "range": {"$ref": "#/$defs/parsedRange"}
              }
            },
            "expected": {"$ref": "#/$defs/position"}
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "name": true,
            "note": true,
            "function": {"const": "resultPosition"},
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "printedRange", "kind", "defaultRange"],
              "properties": {
                "value": {"$ref": "#/$defs/labValue"},
                "printedRange": {"type": ["string", "null"]},
                "kind": {"enum": ["reference", "riskTarget"]},
                "defaultRange": {
                  "oneOf": [{"$ref": "#/$defs/defaultRange"}, {"type": "null"}]
                }
              }
            },
            "expected": {
              "description": "The position and the range it came from, or null for no position.",
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["position", "source"],
                  "properties": {
                    "position": {"$ref": "#/$defs/position"},
                    "source": {"enum": ["printed", "general"]}
                  }
                },
                {"type": "null"}
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
