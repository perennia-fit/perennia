{
  "name": "m34-plan-materialize",
  "domain": "template-materialize",
  "schemaVersion": 1,
  "schema": "m34-plan-materialize.schema.json",
  "cases": [
    {
      "name": "fixed-prescription-repeat-unrolls-to-identical-sets",
      "input": {
        "exercises": [
          {
            "exerciseId": "exercise-bench",
            "dimensions": ["load", "reps"],
            "defaultLoadUnit": "kilogram",
            "prescriptions": [
              {
                "mode": "fixed",
                "fixedValues": {
                  "load": {"entered": "100", "unit": "kilogram"},
                  "reps": {"entered": "5", "unit": "repetition"}
                },
                "lastPerformedValues": null,
                "repeat": 3,
                "restAfterSeconds": 120
              }
            ]
          }
        ],
        "groups": []
      },
      "expected": {
        "exercises": [
          {
            "exerciseId": "exercise-bench",
            "sets": [
              {
                "values": {
                  "load": {"entered": "100", "unit": "kilogram"},
                  "reps": {"entered": "5", "unit": "repetition"}
                },
                "plannedRestAfterSeconds": 120
              },
              {
                "values": {
                  "load": {"entered": "100", "unit": "kilogram"},
                  "reps": {"entered": "5", "unit": "repetition"}
                },
                "plannedRestAfterSeconds": 120
              },
              {
                "values": {
                  "load": {"entered": "100", "unit": "kilogram"},
                  "reps": {"entered": "5", "unit": "repetition"}
                },
                "plannedRestAfterSeconds": 120
              }
            ]
          }
        ],
        "groups": []
      }
    },
