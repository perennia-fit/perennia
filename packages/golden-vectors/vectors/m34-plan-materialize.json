    {
      "name": "multiple-prescriptions-concatenate-in-authored-order",
      "input": {
        "exercises": [
          {
            "exerciseId": "exercise-deadlift",
            "dimensions": ["load", "reps"],
            "defaultLoadUnit": "kilogram",
            "prescriptions": [
              {
                "mode": "fixed",
                "fixedValues": {
                  "load": {"entered": "60", "unit": "kilogram"},
                  "reps": {"entered": "5", "unit": "repetition"}
                },
                "lastPerformedValues": null,
                "repeat": 1,
                "restAfterSeconds": 90
              },
              {
                "mode": "copyPrevious",
                "fixedValues": null,
                "lastPerformedValues": {
                  "load": {"entered": "180", "unit": "kilogram"},
                  "reps": {"entered": "1", "unit": "repetition"}
                },
                "repeat": 1,
                "restAfterSeconds": 240
              }
            ]
          }
        ],
        "groups": []
      },
      "expected": {
        "exercises": [
          {
            "exerciseId": "exercise-deadlift",
            "sets": [
              {
                "values": {
                  "load": {"entered": "60", "unit": "kilogram"},
                  "reps": {"entered": "5", "unit": "repetition"}
                },
                "plannedRestAfterSeconds": 90
              },
              {
                "values": {
                  "load": {"entered": "180", "unit": "kilogram"},
                  "reps": {"entered": "1", "unit": "repetition"}
                },
                "plannedRestAfterSeconds": 240
              }
            ]
          }
        ],
        "groups": []
      }
    },
