          "entries": [
            {
              "kind": "quickEntry",
              "nutrients": {
                "energy": {"status": "complete", "value": 900},
                "protein": {"status": "complete", "value": 70},
                "carbohydrate": {"status": "complete", "value": 80},
                "fat": {"status": "complete", "value": 30}
              }
            }
          ]
        }
      ],
      "goals": {
        "energy": 2000,
        "protein": 150
      },
      "expected": {
        "dayTotals": {
          "2026-06-24": {
            "energy": {"value": 1200, "complete": true},
            "protein": {"value": 90, "complete": true}
          },
          "2026-06-25": {
            "energy": {"value": 900, "complete": true},
            "protein": {"value": 70, "complete": true}
          }
        },
        "periodTotals": {
          "energy": {"value": 2100, "complete": true},
          "protein": {"value": 160, "complete": true},
          "carbohydrate": {"value": 200, "complete": true},
          "fat": {"value": 70, "complete": true}
        },
        "goalProgress": {
          "energy": {"status": "over", "ratio": 1.05, "remaining": -100},
          "protein": {"status": "over", "ratio": 1.0666666666666667, "remaining": -10}
