    {
      "name": "genuine-zero-is-complete-met-goal",
      "days": [
        {
          "localDate": "2026-06-24",
          "entries": [
            {
              "kind": "quickEntry",
              "nutrients": {
                "energy": {"status": "complete", "value": 2000},
                "protein": {"status": "complete", "value": 0}
              }
            }
          ]
        }
      ],
      "goals": {
        "energy": 2000,
        "protein": 0
      },
      "expected": {
        "dayTotals": {
          "2026-06-24": {
            "energy": {"value": 2000, "complete": true},
            "protein": {"value": 0, "complete": true}
          }
        },
        "periodTotals": {
          "energy": {"value": 2000, "complete": true},
          "protein": {"value": 0, "complete": true}
        },
        "goalProgress": {
          "energy": {"status": "met", "ratio": 1, "remaining": 0},
          "protein": {"status": "met", "ratio": null, "remaining": 0}
        }
      }
    }
  ]
}
