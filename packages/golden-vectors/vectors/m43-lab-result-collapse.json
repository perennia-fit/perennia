              "collected": "2026-03-04T08:15",
              "limit": null,
              "printedRange": "135 - 145",
              "printedFlag": null,
              "reportStatus": "interim",
              "fasting": null,
              "labName": "Example Pathology"
            },
            "atTime": "2026-03-03T22:15:00.000Z",
            "updatedAt": "2026-03-04T10:00:00.000Z",
            "deletedAt": null
          },
          {
            "id": "r-final",
            "labTestKey": "sodium",
            "lab": {
              "collected": "2026-03-04T08:15",
              "limit": null,
              "printedRange": "135 - 145",
              "printedFlag": null,
              "reportStatus": "final",
              "fasting": null,
              "labName": "Example Pathology"
            },
            "atTime": "2026-03-03T22:15:00.000Z",
