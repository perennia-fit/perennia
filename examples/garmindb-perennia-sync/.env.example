PRN_BASE_URL=http://localhost:3000
PRN_INTEGRATION_TOKEN=prn_integration_replace_me
PRN_TIMEZONE=UTC

# GarminDB owns Garmin credentials and downloaded data. Configure GarminDB
# separately, then point this example at its local data directory.
GARMINDB_CONFIG_PATH=~/.GarminDb/GarminConnectConfig.json
GARMINDB_DATA_DIR=~/HealthData

# Local state file used to avoid re-uploading FIT files whose content hash
# already imported successfully.
PRN_STATE_PATH=.garmindb-perennia-sync-state.json

# Set true while validating discovery and API preflight without uploading.
PRN_DRY_RUN=false

# Set true if GarminDB is already scheduled separately and this script should
# only discover/upload existing FIT files.
PRN_SKIP_GARMINDB_RUN=false

# Activity FIT files and GarminDB wellness metrics are both enabled by default.
# Wellness metrics include sleep, resting/average/max heart rate, HRV, steps,
# calories, stress, and related Garmin daily summaries when present.
PRN_SYNC_ACTIVITIES=true
PRN_SYNC_METRICS=true
PRN_METRIC_BATCH_SIZE=500
